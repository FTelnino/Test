# Copy to .env and fill in only what your chosen backend needs.
# .env is git-ignored. Never commit real values.
#
# config.py reads .env from the project root or docs/.env, whichever exists.

# --- Groq (the live backend) ---------------------------------------------
# LLM_BACKEND=groq is the default. GROQ_API_KEY is required for it.
# GROQ_MODEL defaults to openai/gpt-oss-20b, which is what every number in
# reports/ was verified against. Changing it does NOT silently keep those
# numbers valid -- re-run `python scripts/evaluate.py` afterwards.
# Real environment variables win over this file, so a Render env var overrides
# anything set here.
# Do not put a retired model id here. This key has no llama model available,
# and llama-3.1-8b-instant returns 404 model_not_found. Check yours with:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" \
#     https://api.groq.com/openai/v1/models | python3 -c "import json,sys;print([m['id'] for m in json.load(sys.stdin)['data']])"
LLM_BACKEND=groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# --- Ollama (offline alternative, no key needed) -------------------------
# Set LLM_BACKEND=ollama above to use this instead.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Small-container tuning (optional) -----------------------------------
# The Render free tier has 512 MB. These are already set in render.yaml; set
# them here too if you run the app somewhere equally tight.
# One torch thread: extra threads only oversubscribe a 0.5 CPU box and each
# carries its own memory.
# EMBED_NUM_THREADS=1
# MALLOC_ARENA_MAX=1 is the more impactful one (glibc allocates one malloc
# arena per core by default and they inflate RSS), but it only takes effect
# if exported before the process starts -- setting it from inside Python is
# too late.
